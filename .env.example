# ==========================================================================
# Banco Sudoers - Database Engineering (Bloco B5)
#
# VOCE NAO PRECISA EDITAR ESTE ARQUIVO. Ele so existe para o caso de a
# porta estar ocupada na sua maquina. O `make` copia este arquivo para
# `.env` sozinho na primeira execucao.
# ==========================================================================

# Porta publicada na SUA maquina (mude so se `make verificar` reclamar)
PORTA_PRODUCAO=5470

# Imagem do PostgreSQL. Mude SO se o instrutor pedir: em rede corporativa o
# Docker Hub pode estar bloqueado, e a imagem vem do registro interno
# (ex.: IMAGEM_POSTGRES=registro.suaempresa.com.br/library/postgres:17).
# Use sempre a versao 17.
IMAGEM_POSTGRES=postgres:17
